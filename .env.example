# Copy to `.env` in the repository root. Never commit `.env`.
#
# Public observe/shadow (R3–R5) does not require credentials.
# R6B read-only validation may load L2 credentials; R7 is required for mutations.

# Optional tooling
# TYREX_HOME=

# Polymarket L2 (placeholders only — never put real values here)
# POLYMARKET_FUNDER=0xYourAddress
# POLYMARKET_API_KEY=your_api_key
# POLYMARKET_API_SECRET=your_api_secret
# POLYMARKET_PASSPHRASE=your_passphrase
# POLYMARKET_SIGNATURE_TYPE=0

# Wallet private key is required only for order signing (R7+). Do not set for R6.
# POLYMARKET_PK=

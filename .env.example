# Copy to `.env` in the repository root. Never commit `.env`.
#
# Public observe/shadow (R3–R5) does not require credentials.
# R6 authenticated reads need L2 API credentials + signer private key.
# R7 is required for mutations (submit/cancel/heartbeat).

# Optional tooling
# TYREX_HOME=

# --- Signer (EOA) — used for POLY_ADDRESS / L2 headers ---
# Historical precedence: TYREX_PRIVATE_KEY > POLYMARKET_PK
# TYREX_PRIVATE_KEY=
# POLYMARKET_PK=

# --- Funder / deposit / proxy wallet (NOT used as POLY_ADDRESS) ---
# Historical precedence: TYREX_FUNDER > POLYMARKET_FUNDER
# Required when signature_type is 1 (proxy), 2 (safe), or 3 (deposit/1271).
# TYREX_FUNDER=
# POLYMARKET_FUNDER=

# --- Signature type (V2): 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE, 3=POLY_1271 ---
# TYREX_SIGNATURE_TYPE=
# POLYMARKET_SIGNATURE_TYPE=0

# --- CLOB L2 API credential triple (pre-created; do not derive during R6D) ---
# POLYMARKET_API_KEY=your_api_key
# POLYMARKET_API_SECRET=your_api_secret
# POLYMARKET_PASSPHRASE=your_passphrase
# POLYMARKET_API_PASSPHRASE=  # alias of PASSPHRASE

# Optional explicit signer override for synthetic tests only (never set to funder):
# POLYMARKET_ADDRESS=
